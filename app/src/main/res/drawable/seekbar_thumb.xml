<?xml version="1.0" encoding="utf-8"?>
<!--
  つまみ。外周にカード色のリングを敷いてトラックから浮かせる
  （影を使わずに立体感を出す＝依存も描画コストも増やさない）。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/surface_container" />
            <size
                android:width="28dp"
                android:height="28dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/seekbar_active" />
            <size
                android:width="20dp"
                android:height="20dp" />
        </shape>
    </item>
</layer-list>
