    <!--
      スライダーのつまみと目盛りを象ったアイコン。
      VectorDrawable は <line> / <rect> を持たないため、直線は stroke 付きの path に、
      角丸矩形（rx = 高さの半分 = 完全な丸端）は fill の path に変換している。
      配置はアダプティブアイコンのセーフゾーン（中央 72x72 = 座標 18〜90）に収まる。
    -->
    <path
        android:pathData="M44,30L44,78"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M60,32L76,32"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M60,50L76,50"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M60,60L70,60"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M60,70L70,70"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <!-- 原本の <rect x="32" y="60" width="24" height="11" rx="5.5"/> と等価な丸端のカプセル -->
    <path
        android:pathData="M37.5,60L50.5,60A5.5,5.5 0 0 1 50.5,71L37.5,71A5.5,5.5 0 0 1 37.5,60Z"
