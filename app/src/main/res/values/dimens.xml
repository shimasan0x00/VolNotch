<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      content_side_padding は values-w600dp / values-w840dp で上書きし、
      タブレットの広い画面でコントロールが端から端まで伸びるのを防ぐ。
    -->
    <dimen name="content_side_padding">24dp</dimen>
    <dimen name="content_vertical_padding">24dp</dimen>

    <!-- カード -->
    <dimen name="card_radius">20dp</dimen>
    <dimen name="card_padding">20dp</dimen>
    <dimen name="card_spacing">16dp</dimen>
    <!-- 夜間は 0dp（values-night/dimens.xml）。暗背景では影が濁るので枠線で表現する。 -->
    <dimen name="card_elevation">2dp</dimen>

    <!-- ストリーム切替セグメント -->
    <dimen name="segment_radius">24dp</dimen>
    <dimen name="segment_item_radius">20dp</dimen>
    <dimen name="segment_inset">4dp</dimen>
    <dimen name="segment_height">44dp</dimen>

    <!-- SeekBar -->
    <dimen name="seekbar_height">14dp</dimen>
    <dimen name="seekbar_radius">7dp</dimen>

    <!-- ボタン -->
    <dimen name="circle_button_size">64dp</dimen>
    <dimen name="pill_height">52dp</dimen>
    <dimen name="pill_radius">26dp</dimen>

    <!-- 警告行（微調整が使えない端末） -->
    <dimen name="warning_radius">12dp</dimen>
</resources>
