<?xml version="1.0" encoding="utf-8"?>
<!--
  ダーク配色。名前は values/colors.xml と 1 対 1 で対応させること
  （drawable / style は名前だけを参照しているため、ここに漏れがあるとビルドは通るのに
   ダークモードでだけ配色が破綻する）。
  ic_launcher_background はランチャー側の見た目なので夜間で変えない＝ここには定義しない。
-->
<resources>
    <!-- 面 -->
    <color name="surface">#0F1614</color>
    <color name="surface_container">#182120</color>
    <color name="outline">#364240</color>

    <!-- 文字 -->
    <color name="on_surface">#E2E8E6</color>
    <color name="on_surface_variant">#B4C0BD</color>

    <!-- アクセント -->
    <color name="primary">#7ED0BE</color>
    <color name="on_primary">#00382F</color>
    <color name="primary_container">#1E4E46</color>
    <color name="on_primary_container">#B7EFE2</color>
    <color name="ripple">#337ED0BE</color>

    <!-- SeekBar の未到達部・セグメントの台座 -->
    <color name="track_inactive">#2C3735</color>

    <!-- 「この端末では使用できません」の警告行 -->
    <color name="warning">#FFB68A</color>
    <color name="warning_container">#4A2612</color>

    <!-- 微調整が非対応の端末で無効化されたコントロール -->
    <color name="disabled_container">#232B2A</color>
    <color name="disabled_content">#6A7573</color>
</resources>
